# .zshenv - runs for ALL shell types (interactive, non-interactive, login, script)
# Keep this minimal — only PATH and env vars needed by non-interactive shells

{{ if eq .chezmoi.os "linux" -}}
# Linuxbrew
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ end -}}

# Cargo/Rust
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
export PATH="$HOME/.cargo/bin:$PATH"

# Default editor — needed by non-interactive shells and daemons (e.g. herdr's
# scrollback-to-editor, which spawns ${EDITOR:-vi} from the server process).
# .zshrc may override this for interactive shells (e.g. nvr inside a session).
export EDITOR='nvim'
export VISUAL='nvim'

{{ if eq .chezmoi.hostname "devbox" -}}
# Devbox-only: forward URL opens to sot's browser via lemonade.
# Devbox is headless (no local browser), so tools honoring $BROWSER
# (gh, lazygit, az login, xdg-open) need lemonade to ship the URL
# over Tailscale to a `lemonade server` running on sot.
#
# Do NOT set this on machines with a local browser (sot itself) —
# it would redirect their own URL opens through lemonade and break
# `xdg-open` / `az login` browser launches.
export BROWSER="$HOME/.local/bin/lemonade-open"
{{ end -}}
