# Files to ignore (not managed by chezmoi)

# macOS
.DS_Store
**/.DS_Store

# Editor state
Session.vim
**/Session.vim

# Git inside configs (we use .chezmoiexternal for oh-my-zsh)
**/.git
**/.github

# oh-my-zsh cache (generated)
.oh-my-zsh/cache

# Secrets are sourced separately
.secrets

# Machine-specific or generated
.zsh_history
.bash_history
.lesshst
.node_repl_history
.python_history

# Zellij plugins (large wasm files, installed separately)
.config/zellij/plugins

# Neovim state and plugins (managed by lazy.nvim)
.local/share/nvim
.local/state/nvim
.cache/nvim

# Emacs (packages, cache, state - all generated)
.emacs.d/*
!.emacs.d/init.el
!.emacs.d/early-init.el
!.emacs.d/custom-vars.el

# Lemonade: server plist is atlas (darwin) only; shim scripts are devbox (linux) only
{{ if ne .chezmoi.os "darwin" -}}
Library
{{ end -}}
{{ if ne .chezmoi.os "linux" -}}
.local/bin/xclip
.local/bin/xsel
.local/bin/lemonade-open
.local/bin/screenshot-region
.local/bin/screenshot-screen
.local/bin/screenshot-window
.local/bin/focus-or-launch
.config/niri
.config/noctalia
.config/systemd
{{ end -}}
