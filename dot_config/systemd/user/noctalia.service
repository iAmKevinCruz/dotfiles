[Unit]
Description=Noctalia Shell (v5)
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/noctalia
# v4 fallback: ExecStart=/usr/bin/qs -c noctalia-shell
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
