layout {

    focus-ring {
        active-color   "#a2cbf2"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a2cbf2"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#a2cbf2"
        inactive-color "#517a9e"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a2cbf280"
    }
}

recent-windows {
    highlight {
        active-color "#a2cbf2"
        urgent-color "#ffb4ab"
    }
}
