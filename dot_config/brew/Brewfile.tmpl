# macOS-only: Fonts
# ===================
brew "fontconfig"
cask "font-jetbrains-mono-nerd-font"
cask "font-caskaydia-cove-nerd-font"
cask "font-iosevka-term-nerd-font"
cask "font-fira-mono-nerd-font"
cask "font-source-code-pro"
cask "font-source-sans-3"

# ===================
# macOS-only: GUI Apps
