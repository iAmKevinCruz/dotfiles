# Brewfile - works on macOS and Linux (Linuxbrew)
# Usage: brew bundle install --file ~/.config/brew/Brewfile
# Alias: bbic (update, install, cleanup, upgrade)
#
# ===================
# Adding New Packages
# ===================
# Check if a formula exists on both platforms:
#   brew info <package>                    # shows info if installed/available
#   brew search <package>                  # search for packages
#   https://formulae.brew.sh/<package>     # web lookup, shows "Linux" badge if supported
#
# Rules of thumb:
#   - "brew" formulae: most work on both macOS and Linux
#   - "cask" packages: macOS-only (GUI apps, fonts)
#   - "tap" repos: check the tap's README for Linux support
#   - "mas" (Mac App Store): macOS-only
#
# Where to put new packages:
#   - Works on both → add to "Cross-platform" section (no template conditional)
#   - macOS-only    → add inside the darwin conditional blocks
#   - Linux-only    → add inside a linux conditional: {{ "{{ if eq .chezmoi.os \"linux\" }}" }}

# ===================
# Taps (must be first - shorthand auto-tap doesn't work reliably on Linuxbrew)
# ===================
tap "oven-sh/bun"
tap "jorgerojas26/lazysql"
tap "jesseduffield/lazydocker"
tap "azure/functions"
tap "supabase/tap"
tap "infisical/get-cli"
{{ if eq .chezmoi.os "darwin" -}}
tap "d12frosted/emacs-plus"
tap "shopify/shopify"
tap "anomalyco/tap"
{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
