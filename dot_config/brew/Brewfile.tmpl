cask "zen-browser"
cask "obsidian"
cask "discord"
cask "wezterm@nightly"
cask "kitty@nightly"
cask "karabiner-elements"
cask "ngrok"
cask "medis"
cask "neovide"

# ===================
# macOS-only: Tools
# ===================
