# Neovim remote setup
function vr() {
  local project_name branch server_path
  project_name=$(git rev-parse --git-dir 2>/dev/null)
  project_name="${project_name%/worktrees/*}"
  project_name=$(basename "$project_name" 2>/dev/null)
  if [[ -n "$project_name" ]]; then
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    branch=${branch//\//-}
    server_path="/tmp/${project_name}/${branch}/nvim-server.pipe"
    mkdir -p "$(dirname "$server_path")"
  else
    server_path="/tmp/nvim-server.pipe"
  fi
  echo "Opening in remote: $server_path"
  command nvim --listen "$server_path" "$@"
}

if [ -n "$NVIM_LISTEN_ADDRESS" ]; then
  export VISUAL="nvr -cc split --remote-wait +'set bufhidden=wipe'"
  export EDITOR="nvr -cc split --remote-wait +'set bufhidden=wipe'"
