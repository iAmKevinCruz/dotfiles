#!/usr/bin/env bash
# xclip/xsel shim → forwards clipboard ops to sot via lemonade RPC.
#
# Installed as ~/.local/bin/xclip and symlinked as ~/.local/bin/xsel so TUIs
# (lazysql, nvim, atotto/clipboard, etc.) that probe for either tool pipe
# their clipboard through lemonade to sot.
#
# Read mode (-o / --output) returns sot's clipboard contents.
# Write mode (no -o flag) sends stdin to sot's clipboard.
# All -selection / -b / -p / etc. flags are ignored — lemonade has one clipboard.
#
# Hard timeout on every call: when the lemonade server is unreachable,
# lemonade's client falls back to invoking xclip locally. This shim IS xclip
# — without a timeout that becomes a fork bomb.

set -euo pipefail

HOST=100.72.212.29   # sot Tailscale IP
PORT=2489
LEMONADE="$HOME/go/bin/lemonade"

is_read=0
for arg in "$@"; do
  case "$arg" in
    -o|-out|--out|--output) is_read=1 ;;
  esac
done

if ! timeout 1 bash -c "exec 3<>/dev/tcp/$HOST/$PORT" 2>/dev/null; then
  echo "xclip(lemonade): sot ($HOST:$PORT) unreachable" >&2
  exit 1
fi

if [[ $is_read -eq 1 ]]; then
  exec timeout 2 "$LEMONADE" --host="$HOST" paste
else
  exec timeout 2 "$LEMONADE" --host="$HOST" copy
fi
