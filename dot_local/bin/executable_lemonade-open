#!/usr/bin/env bash
# BROWSER wrapper → opens URL in sot's (Framework 16) browser via lemonade RPC.
# Used by lazygit openLink, gh, xdg-open shim, anything honoring $BROWSER.
#
# Fire-and-forget + hard timeout. Rationale:
#   * Devbox is headless — there's no point blocking the caller (lazygit,
#     az login, etc.) on a successful remote browser-open.
#   * `lemonade open` has been observed to accept the TCP connection but
#     never ack the RPC, hanging the client indefinitely. Without setsid +
#     timeout this freezes the entire TUI pane.
#
# Single host: atlas (MacBook) was retired in May 2026. Update HOST below
# (and the matching entry in executable_xclip + ~/.config/lemonade/README.md)
# if the workstation changes.

set -euo pipefail

HOST=100.72.212.29   # sot Tailscale IP
PORT=2489
LEMONADE="$HOME/go/bin/lemonade"

# Always surface the URL so it can be copy/pasted if the remote open fails
# (fire-and-forget below means failures on sot are otherwise silent).
echo "lemonade-open → sot: $*" >&2

# Fast TCP probe so we exit cleanly with a useful message when sot is offline,
# instead of waiting on the 3s timeout below.
if ! timeout 1 bash -c "exec 3<>/dev/tcp/$HOST/$PORT" 2>/dev/null; then
  echo "lemonade-open: sot ($HOST:$PORT) unreachable — open manually: $*" >&2
  exit 1
fi

setsid -f timeout 3 "$LEMONADE" --host="$HOST" open "$@" \
  </dev/null >/dev/null 2>&1
exit 0
